 # LLM provider
# Required for LLM-powered intent classification and response generation.
LLM_API_KEY=your_llm_api_key_here

# Optional: OpenAI-compatible API base URL. Defaults to https://openrouter.ai/api/v1.
LLM_API_BASE_URL=https://openrouter.ai/api/v1

# Optional: defaults to openai/gpt-4.1-mini.
LLM_BASE_MODEL=openai/gpt-4.1-mini

# Optional: required only for the news scrape agent.
EXA_API_KEY=your_exa_api_key_here

# Optional: required only for the weather agent.
WEATHER_API_KEY=your_weather_api_key_here
