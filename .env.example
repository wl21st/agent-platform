 # LLM provider
# Required for LLM-powered intent classification and response generation.
LLM_API_KEY=your_llm_api_key_here

# Optional: defaults to https://openrouter.ai/api/v1.
LLM_API_BASE_URL=https://openrouter.ai/api/v1
# Legacy alias. Used only when LLM_API_BASE_URL is not set.
LLM_API_URL=https://openrouter.ai/api/v1

# Optional: defaults to openai/gpt-4.1-mini.
LLM_BASE_MODEL=openai/gpt-4.1-mini

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Agents Platform

# Optional: required only for the news scrape agent.
EXA_API_KEY=your_exa_api_key_here

# Optional: required only for the weather agent.
WEATHERAPI_API_KEY=your_weatherapi_api_key_here
